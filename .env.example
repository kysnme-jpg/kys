# ─── Database ───────────────────────────────────────────────────────────────
# Railway Postgres: set this to the ${{Postgres.DATABASE_URL}} reference variable.
# Railway runs a persistent server, so a direct connection is used (no pooler).
DATABASE_URL="postgresql://user:password@host:5432/railway"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# NEXTAUTH_URL must be your public Railway domain in production,
# e.g. https://your-app.up.railway.app
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# ─── Consignor/Dealer Portal JWT (separate from NextAuth) ─────────────────────
PORTAL_JWT_SECRET="generate-with: openssl rand -base64 32"

# ─── Item photo storage (Railway Volume) ─────────────────────────────────────
# Attach a Railway Volume to the service. Its mount path is exposed automatically
# as RAILWAY_VOLUME_MOUNT_PATH, and photos are written under <mount>/uploads.
# Set UPLOAD_DIR only to override with an explicit absolute path.
# UPLOAD_DIR="/data/uploads"

# ─── Clover (optional — in-store card payments) ──────────────────────────────
# https://www.clover.com/developers
CLOVER_API_KEY=""
CLOVER_MERCHANT_ID=""

# ─── Anthropic / Claude (optional — AI item entry, claude-haiku-4-5) ─────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# ─── Resend (optional — transactional email) ─────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=""
EMAIL_FROM="ConsignPro <noreply@yourdomain.com>"

# ─── Shopify Webhooks (optional — from Shopify Partner Dashboard) ─────────────
SHOPIFY_WEBHOOK_SECRET=""
