generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// ─── AUTH ────────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── STORE ───────────────────────────────────────────────────────────────────

model Store {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  address          String?
  phone            String?
  email            String?
  logoUrl          String?
  contractTemplate String?  @db.Text
  taxRate          Float    @default(0)
  currency         String   @default("USD")
  timezone         String   @default("America/New_York")
  cloverApiKey     String?
  cloverMerchantId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users            User[]
  consignors       Consignor[]
  items            Item[]
  sales            Sale[]
  payouts          Payout[]
  categories       Category[]
  customers        Customer[]
  discountRules    DiscountRule[]
  apiKeys          ApiKey[]
  webhookEndpoints WebhookEndpoint[]
  contracts        Contract[]
  workLogs         WorkLog[]
  consignAppts     ConsignAppointment[]
  consignBlocks    ConsignBlockedDate[]
  layaways         Layaway[]
  borrowedGarments BorrowedGarment[]
  sipShopEvents    SipShopEvent[]
  emailLogs        EmailLog[]
  consignorMessages ConsignorMessage[]
  rolePermissions  RolePermission[]
  posts            Post[]
  externalThreads  ExternalThread[]
  internalChannels InternalChannel[]
  internalThreads  InternalThread[]
  tags             Tag[]
  notificationSetting NotificationSetting?
}

// ─── USERS (store staff) ──────────────────────────────────────────────────────

enum UserRole {
  OWNER
  MANAGER
  EMPLOYEE // legacy alias → "associate"
  ASSOCIATE
  INVENTORY_CLERK
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(EMPLOYEE)
  storeId       String?
  store         Store?    @relation(fields: [storeId], references: [id])
  // Staff profile (§1)
  phone         String?
  active        Boolean   @default(true)
  lastLoginAt   DateTime?
  staffNotes    String?   @db.Text // internal-only notes about this staff member
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
}

// Database-backed RBAC (§1): one row per (role, permission). Seeded from
// DEFAULT_ROLE_PERMISSIONS; editable later by an admin UI. The authorization
// helper reads these instead of hardcoded role checks.
model RolePermission {
  id         String @id @default(cuid())
  storeId    String
  store      Store  @relation(fields: [storeId], references: [id])
  role       String // UserRole value, as text
  permission String // permission code (see src/lib/authz.permissions)

  @@unique([storeId, role, permission])
  @@index([storeId, role])
}

// ─── CONSIGNORS ───────────────────────────────────────────────────────────────

model Consignor {
  id               String    @id @default(cuid())
  storeId          String
  store            Store     @relation(fields: [storeId], references: [id])
  firstName        String
  lastName         String
  email            String?
  phone            String?
  address          String?
  splitPercent     Float     @default(50)
  balance          Float     @default(0)
  notes            String?
  contractSignedAt DateTime?
  portalPassword   String?
  portalEnabled    Boolean   @default(true) // on by default; they can sign in once a login has been sent
  portalMustReset  Boolean   @default(false) // force a password reset on next portal login
  bankAccountMask  String?
  achEnabled       Boolean   @default(false)
  payoutMethod     PayoutMethod?
  zelleHandle      String?
  cashAppHandle    String?
  unsoldPreference String?   // PICKUP | DONATE | CONTINUE
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  items          Item[]
  ledgerEntries  LedgerEntry[]
  payouts        Payout[]
  contracts      Contract[]
  emailLogs      EmailLog[]
  messages       ConsignorMessage[]
  externalThread ExternalThread?
  tagAssignments TagAssignment[]
}

// ─── CATEGORIES ───────────────────────────────────────────────────────────────

model Category {
  id       String     @id @default(cuid())
  storeId  String
  store    Store      @relation(fields: [storeId], references: [id])
  name     String
  slug     String
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  items    Item[]

  @@unique([storeId, slug])
}

// ─── INVENTORY ITEMS ──────────────────────────────────────────────────────────

enum ItemType {
  CONSIGNED
  OWNED
}

enum ItemStatus {
  ACTIVE
  SOLD
  RETURNED
  DONATED
  EXPIRED
}

model Item {
  id           String     @id @default(cuid())
  storeId      String
  store        Store      @relation(fields: [storeId], references: [id])
  consignorId  String?
  consignor    Consignor? @relation(fields: [consignorId], references: [id])
  categoryId   String?
  category     Category?  @relation(fields: [categoryId], references: [id])

  sku            String     @unique @default(cuid())
  barcode        String?
  title          String
  description    String?
  brand          String?
  size           String?
  color          String?
  condition      String?
  type           ItemType   @default(CONSIGNED)
  status         ItemStatus @default(ACTIVE)

  price          Float
  costPrice      Float?
  location       String?    // IN_STORE | STORAGE
  splitPercent   Float?

  photoUrls      String[]
  shopifyId      String?

  listedOnline   Boolean    @default(false)
  featuredOnline Boolean    @default(false)

  expiresAt      DateTime?
  soldAt         DateTime?
  returnRequestedAt DateTime? // consignor asked (via portal) to have this item back
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  saleItems      SaleItem[]
}

// ─── CUSTOMERS ────────────────────────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  firstName String
  lastName  String
  email     String?
  phone     String?
  points    Int      @default(0)
  birthday  String?  // "MM-DD" for birthday offers
  source    String?  // how they heard about us
  createdAt DateTime @default(now())

  sales          Sale[]
  externalThread ExternalThread?
  tagAssignments TagAssignment[]
}

// ─── SALES ────────────────────────────────────────────────────────────────────

enum PaymentMethod {
  CASH
  CARD_CLOVER
  STORE_CREDIT
  SPLIT
}

enum SaleStatus {
  COMPLETED
  REFUNDED
  VOIDED
}

model Sale {
  id             String        @id @default(cuid())
  storeId        String
  store          Store         @relation(fields: [storeId], references: [id])
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id])

  subtotal       Float
  taxAmount      Float         @default(0)
  discountAmount Float         @default(0)
  total          Float
  // Refunds recorded against this sale (tax-inclusive amount given back, and the
  // tax portion of it). Net revenue = total − refundedAmount.
  refundedAmount Float         @default(0)
  refundedTax    Float         @default(0)
  status         SaleStatus    @default(COMPLETED)
  paymentMethod  PaymentMethod @default(CARD_CLOVER)
  cloverOrderId  String?
  receiptEmail   String?
  notes          String?
  createdAt      DateTime      @default(now())

  items         SaleItem[]
  ledgerEntries LedgerEntry[]
}

model SaleItem {
  id           String @id @default(cuid())
  saleId       String
  sale         Sale   @relation(fields: [saleId], references: [id])
  itemId       String
  item         Item   @relation(fields: [itemId], references: [id])
  price        Float
  splitPercent Float
  refundedAt   DateTime? // set when this line was refunded
}

// ─── CONSIGNOR LEDGER ─────────────────────────────────────────────────────────

enum LedgerType {
  SALE_CREDIT
  PAYOUT_DEBIT
  FEE_DEBIT
  ADJUSTMENT
}

model LedgerEntry {
  id          String     @id @default(cuid())
  consignorId String
  consignor   Consignor  @relation(fields: [consignorId], references: [id])
  saleId      String?
  sale        Sale?      @relation(fields: [saleId], references: [id])
  payoutId    String?
  payout      Payout?    @relation(fields: [payoutId], references: [id])
  itemId      String?
  type        LedgerType
  amount      Float
  note        String?
  createdAt   DateTime   @default(now())
}

// ─── PAYOUTS ─────────────────────────────────────────────────────────────────

enum PayoutMethod {
  CHECK
  CASH
  ACH
  ZELLE
  CASHAPP
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Payout {
  id           String       @id @default(cuid())
  storeId      String
  store        Store        @relation(fields: [storeId], references: [id])
  consignorId  String
  consignor    Consignor    @relation(fields: [consignorId], references: [id])
  amount       Float
  method       PayoutMethod @default(CHECK)
  status       PayoutStatus @default(PENDING)
  checkNumber  String?
  achReference String?
  destination  String?
  note         String?
  createdAt    DateTime     @default(now())
  completedAt  DateTime?

  ledgerEntries LedgerEntry[]
}

// ─── DISCOUNT RULES ───────────────────────────────────────────────────────────

model DiscountRule {
  id        String    @id @default(cuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id])
  name      String
  type      String
  value     Float
  code      String?   @unique
  startsAt  DateTime?
  endsAt    DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
}

// ─── API KEYS ─────────────────────────────────────────────────────────────────

model ApiKey {
  id          String    @id @default(cuid())
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id])
  name        String
  keyHash     String    @unique
  keyPrefix   String
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

// ─── WEBHOOK ENDPOINTS ────────────────────────────────────────────────────────

model WebhookEndpoint {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  url       String
  events    String[] // e.g. ["sale.created", "payout.created"]
  secret    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id           String          @id @default(cuid())
  endpointId   String
  endpoint     WebhookEndpoint @relation(fields: [endpointId], references: [id])
  event        String
  payload      Json
  responseCode Int?
  success      Boolean         @default(false)
  attemptedAt  DateTime        @default(now())
}

// ─── EMPLOYEE WORK LOG (ADMIN) ────────────────────────────────────────────────

model WorkLog {
  id           String   @id @default(cuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id])
  employeeName String
  phone        String?
  date         DateTime @default(now())
  hours        Float    @default(0)
  payout       Float    @default(0)
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── TAGS / SEGMENTS (§5) ────────────────────────────────────────────────────
// Reusable labels applied to consignors and customers, used as an audience in
// the content feed and email blasts. A tag assignment targets exactly one
// external party (consignor OR customer) — CHECK-constrained in the migration.

model Tag {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  name      String
  color     String   @default("#b4532a")
  createdAt DateTime @default(now())

  assignments TagAssignment[]

  @@unique([storeId, name])
  @@index([storeId])
}

model TagAssignment {
  id          String     @id @default(cuid())
  tagId       String
  tag         Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)
  consignorId String?
  consignor   Consignor? @relation(fields: [consignorId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())

  @@unique([tagId, consignorId])
  @@unique([tagId, customerId])
  @@index([consignorId])
  @@index([customerId])
}

// ─── NOTIFICATION SETTINGS (§7) ──────────────────────────────────────────────
// Owner-controlled toggles for which events also send an email. Internal/staff
// notifications never carry message content (§4a Layer 7); the email nudges here
// only prompt the recipient to log in.

model NotificationSetting {
  id      String @id @default(cuid())
  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id])

  notifyStoreOnInboundMessage Boolean @default(true)
  notifyConsignorOnStoreReply Boolean @default(true)
  notifyAudienceOnNewPost     Boolean @default(false)
  notifyEmail                 String? // where store notifications go; defaults to store.email

  updatedAt DateTime @updatedAt
}

// ─── EXTERNAL MESSAGING (§4) ─────────────────────────────────────────────────
// Store ↔ external party (consignor OR customer). PHYSICALLY SEPARATE from any
// internal (staff↔staff) messaging — that is the §4a isolation boundary. Every
// read/write goes through src/lib/messaging/external.ts (Layer 5). A thread has
// exactly ONE external party (enforced in the repository now; a DB CHECK
// constraint + RLS land at the migrate cutover / Phase 6). The @unique columns
// already guarantee at most one thread per consignor and per customer.

model ExternalThread {
  id            String  @id @default(cuid())
  storeId       String
  store         Store   @relation(fields: [storeId], references: [id])
  externalClass String // "CONSIGNOR" | "CUSTOMER"
  consignorId   String?    @unique
  consignor     Consignor? @relation(fields: [consignorId], references: [id])
  customerId    String?    @unique
  customer      Customer?  @relation(fields: [customerId], references: [id])
  subject       String?
  status        String   @default("OPEN") // OPEN | ARCHIVED
  lastMessageAt DateTime @default(now())
  // §7 throttle: last time an email nudge was sent for each direction.
  storeNotifiedAt    DateTime?
  externalNotifiedAt DateTime?
  createdAt     DateTime @default(now())

  messages ExternalMessage[]
  notes    ExternalInternalNote[]

  @@index([storeId, status, lastMessageAt])
}

model ExternalMessage {
  id                String         @id @default(cuid())
  threadId          String
  thread            ExternalThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderClass       String // "INTERNAL" | "EXTERNAL"
  senderUserId      String? // staff author
  senderConsignorId String?
  senderCustomerId  String?
  body              String         @db.Text
  readByStore       Boolean        @default(false)
  readByExternal    Boolean        @default(false)
  createdAt         DateTime       @default(now())

  @@index([threadId, createdAt])
}

// Staff-only notes attached to an external thread. NEVER returned to the
// external party — this is the "internal note on an external conversation"
// from §4, kept in a separate table so it can never leak through a message read.
model ExternalInternalNote {
  id           String         @id @default(cuid())
  threadId     String
  thread       ExternalThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorUserId String?
  body         String         @db.Text
  createdAt    DateTime       @default(now())

  @@index([threadId, createdAt])
}

// ─── INTERNAL MESSAGING (§3) ─────────────────────────────────────────────────
// Staff ↔ staff only. PHYSICALLY SEPARATE from external messaging — these tables
// reference staff (userId) exclusively and never a consignor/customer, which is
// the §4a isolation boundary from the other side. Every read/write goes through
// src/lib/messaging/internal.ts (Layer 5). Two shapes share the message table:
// group CHANNELS (open to all staff in the store) and DIRECT threads (explicit
// participants). A message belongs to exactly one of them.

model InternalChannel {
  id              String   @id @default(cuid())
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id])
  name            String
  description     String?
  createdByUserId String?
  lastMessageAt   DateTime @default(now())
  createdAt       DateTime @default(now())

  messages     InternalMessage[]
  participants InternalParticipant[]

  @@index([storeId, lastMessageAt])
}

model InternalThread {
  id              String   @id @default(cuid())
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id])
  createdByUserId String?
  lastMessageAt   DateTime @default(now())
  createdAt       DateTime @default(now())

  messages     InternalMessage[]
  participants InternalParticipant[]

  @@index([storeId, lastMessageAt])
}

// Membership + per-user read state for a channel OR a direct thread.
model InternalParticipant {
  id         String           @id @default(cuid())
  userId     String
  channelId  String?
  channel    InternalChannel? @relation(fields: [channelId], references: [id], onDelete: Cascade)
  threadId   String?
  thread     InternalThread?  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  lastReadAt DateTime?
  createdAt  DateTime         @default(now())

  @@unique([channelId, userId])
  @@unique([threadId, userId])
  @@index([userId])
}

model InternalMessage {
  id           String           @id @default(cuid())
  channelId    String?
  channel      InternalChannel? @relation(fields: [channelId], references: [id], onDelete: Cascade)
  threadId     String?
  thread       InternalThread?  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderUserId String
  body         String           @db.Text
  createdAt    DateTime         @default(now())

  @@index([channelId, createdAt])
  @@index([threadId, createdAt])
}

// ─── CONTENT FEED / POSTS (§2) ───────────────────────────────────────────────

enum PostType {
  ANNOUNCEMENT
  NEWS
  EVENT
  PROMOTION
}

enum PostStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

// Who a post is shown to. INTERNAL_ROLE uses audienceRole; TAG uses audienceTag
// (tags land in §5). ALL_CUSTOMERS is defined for when customers get logins.
enum AudienceScope {
  EVERYONE
  ALL_INTERNAL
  INTERNAL_ROLE
  ALL_CONSIGNORS
  ALL_CUSTOMERS
  TAG
}

model Post {
  id            String        @id @default(cuid())
  storeId       String
  store         Store         @relation(fields: [storeId], references: [id])
  authorUserId  String?
  type          PostType      @default(ANNOUNCEMENT)
  title         String
  body          String        @db.Text
  imageUrl      String?
  linkUrl       String?
  linkLabel     String?
  rsvpEnabled   Boolean       @default(false)
  audienceScope AudienceScope @default(EVERYONE)
  audienceRole  String?
  audienceTag   String?
  status        PostStatus    @default(DRAFT)
  publishAt     DateTime?
  expiresAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  rsvps PostRsvp[]

  @@index([storeId, status])
}

model PostRsvp {
  id          String   @id @default(cuid())
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  actorClass  String // INTERNAL | EXTERNAL
  userId      String?
  consignorId String?
  response    String // YES | NO | MAYBE
  createdAt   DateTime @default(now())

  @@unique([postId, userId])
  @@unique([postId, consignorId])
}

// ─── EMAIL LOG ───────────────────────────────────────────────────────────────

model EmailLog {
  id          String     @id @default(cuid())
  storeId     String
  store       Store      @relation(fields: [storeId], references: [id])
  consignorId String?
  consignor   Consignor? @relation(fields: [consignorId], references: [id])
  to          String
  type        String     // INVENTORY | CONTRACT | APPOINTMENT | OTHER
  subject     String?
  status      String     @default("SENT") // SENT | TEST | FAILED
  createdAt   DateTime   @default(now())
}

// ─── LAYAWAY AGREEMENTS ──────────────────────────────────────────────────────

model Layaway {
  id           String    @id @default(cuid())
  storeId      String
  store        Store     @relation(fields: [storeId], references: [id])
  buyerName    String
  address      String?
  cityStateZip String?
  phone        String?
  email        String?
  items        String    @db.Text
  totalPrice   Float
  serviceFee   Float     @default(5)
  deposit      Float     @default(0)
  payment2     Float     @default(0)
  payment3     Float     @default(0)
  finalPayment Float     @default(0)
  amountPaid   Float     @default(0)
  startDate    DateTime  @default(now())
  status       String    @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED
  reminder15At DateTime?
  reminder30At DateTime?
  reminder45At DateTime?
  // Recurring reminders: one every 14 days from startDate until paid.
  // reminderCount = how many 14-day periods have been reminded for.
  reminderCount  Int       @default(0)
  lastReminderAt DateTime? // most recent reminder of any kind (automatic or manual)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ─── BORROWED GARMENT AGREEMENTS ─────────────────────────────────────────────

model BorrowedGarment {
  id               String    @id @default(cuid())
  storeId          String
  store            Store     @relation(fields: [storeId], references: [id])
  borrowerName     String
  phone            String?
  email            String?
  idNumber         String?
  dateBorrowed     DateTime  @default(now())
  returnDate       DateTime?
  items            String    @db.Text
  conditionPickup  String?
  conditionDropoff String?
  dryCleaning      String?   // BORROWER | NOT_BORROWER | UPON_RETURN
  status           String    @default("OUT") // OUT | RETURNED
  returnReminderAt DateTime?
  day3ReminderAt   DateTime? // automatic reminder 3 days after borrowing
  lastReminderAt   DateTime? // most recent reminder of any kind (automatic or manual)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// ─── SIP & SHOP EVENTS ───────────────────────────────────────────────────────

model SipShopEvent {
  id             String    @id @default(cuid())
  storeId        String
  store          Store     @relation(fields: [storeId], references: [id])
  hostName       String
  phone          String?
  email          String?
  guests         Int       @default(0)
  eventDate      DateTime  // date-only, UTC midnight
  notes          String?
  status         String    @default("SCHEDULED") // SCHEDULED | COMPLETED | CANCELLED
  reminderSentAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ─── CONSIGNMENT APPOINTMENTS (new-consignor booking) ────────────────────────

model ConsignAppointment {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  date      DateTime // the appointment day (date-only, UTC midnight)
  slot      Int      // 0-3 = standard Saturday slots; >=10 = custom day/time entries
  startTime String?  // "HH:MM" for custom appointments (any day/time)
  name      String
  email     String?
  phone     String?
  note      String?
  createdAt DateTime @default(now())

  @@unique([storeId, date, slot])
}

model ConsignBlockedDate {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  date      DateTime // the Saturday being blocked (date-only, UTC midnight)
  reason    String?
  createdAt DateTime @default(now())

  @@unique([storeId, date])
}

// ─── CONSIGNMENT CONTRACTS ────────────────────────────────────────────────────

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  EXPIRED
}

model Contract {
  id           String         @id @default(cuid())
  storeId      String
  store        Store          @relation(fields: [storeId], references: [id])
  consignorId  String
  consignor    Consignor      @relation(fields: [consignorId], references: [id])
  title        String         @default("Consignment Agreement")
  body         String         @db.Text
  splitPercent Float
  status       ContractStatus @default(DRAFT)
  signedAt     DateTime?
  signatureData String?       @db.Text // base64 SVG/PNG of signature
  signerIp     String?
  expiresAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

// ─── CONSIGNOR ↔ STORE MESSAGES ───────────────────────────────────────────────

model ConsignorMessage {
  id              String    @id @default(cuid())
  storeId         String
  store           Store     @relation(fields: [storeId], references: [id])
  consignorId     String
  consignor       Consignor @relation(fields: [consignorId], references: [id])
  sender          String    // "STORE" | "CONSIGNOR"
  body            String    @db.Text
  readByStore     Boolean   @default(false)
  readByConsignor Boolean   @default(false)
  createdAt       DateTime  @default(now())

  @@index([consignorId, createdAt])
}
